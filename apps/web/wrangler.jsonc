{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomo-site",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
  },
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://tomo-site.page",
    "MICROCMS_SERVICE_DOMAIN": "tomo-site",
    "CONTACT_FROM_EMAIL": "TOMO Website <contact@tomo-site.page>",
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "20260921",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "MICROCMS_SERVICE_DOMAIN": "tomo-site",
      "CONTACT_FROM_EMAIL": "TOMO Website <contact@tomo-site.page>",
    },
    "ratelimits": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "namespace_id": "20261010",
        "simple": {
          "limit": 5,
          "period": 60,
        },
      },
    ],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
}
