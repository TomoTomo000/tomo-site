{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomo-site",
  "main": "./src/worker.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "CROSSPOST_DB",
      "database_name": "tomo-site-crosspost",
      "database_id": "d49a618b-653f-4355-bd23-01eea2c37e33",
      "migrations_dir": "migrations",
    },
  ],
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
  },
  "vars": {
    "APP_ENV": "production",
    "CROSSPOST_ENABLED": "true",
    "ZENN_GITHUB_OWNER": "TomoTomo000",
    "ZENN_GITHUB_REPOSITORY": "zenn-content",
    "ZENN_GITHUB_BRANCH": "main",
    "ZENN_USERNAME": "tomotomo000",
    "SITE_URL": "https://tomo-site.page",
    "MICROCMS_SERVICE_DOMAIN": "tomo-site",
    "CONTACT_FROM_EMAIL": "TOMO Website <contact@tomo-site.page>",
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "20260921",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "CROSSPOST_ENABLED": "false",
      "MICROCMS_SERVICE_DOMAIN": "tomo-site",
      "CONTACT_FROM_EMAIL": "TOMO Website <contact@tomo-site.page>",
    },
    "ratelimits": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "namespace_id": "20261010",
        "simple": {
          "limit": 5,
          "period": 60,
        },
      },
    ],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
}
