---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<main class="l-error">
  <div>
    <p class="l-error__code">404</p>
    <h1 class="l-error__title">ページが見つかりません</h1>
    <p class="l-error__description">
      URLが変更されたか、ページが削除された可能性があります。
    </p>
    <div class="l-error__actions">
      <ButtonLink href="/">トップページに戻る</ButtonLink>
    </div>
  </div>
</main>
