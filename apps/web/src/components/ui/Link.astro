---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"a"> {
  variant?: "text" | "surface" | "control";
}
const { variant = "text", class: className = "", ...props } = Astro.props;
---

<a
  {...props}
  class={["c-link", "c-link--" + variant, className].filter(Boolean).join(" ")}
>
  <slot />
</a>
