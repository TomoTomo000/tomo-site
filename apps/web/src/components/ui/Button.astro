---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
}
const {
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  ...props
} = Astro.props;
---

<button
  {...props}
  type={type}
  class={["c-button", "c-button--" + variant, "c-button--" + size, className]
    .filter(Boolean)
    .join(" ")}
>
  <slot />
</button>
