---
import { blogUrl } from "@/lib/urls";
import Button from "@/components/ui/Button.astro";
import IconButton from "@/components/ui/IconButton.astro";
import CloseIcon from "@/components/ui/icons/CloseIcon.astro";
import AppLink from "@/components/ui/Link.astro";
import type { PaginatedPosts, Taxonomy } from "../types/post.types";
import BlogContainer from "@/components/layout/PageContainer.astro";
import PostCard from "./PostCard.astro";
type BlogSearch = {
  page: number;
  query: string;
  tag: string;
};
type Props = {
  posts: PaginatedPosts;
  search: BlogSearch;
  tags: Taxonomy[];
};
const { posts, search, tags } = Astro.props;
---

<main class="l-blog-list">
  <BlogContainer>
    <div class="m-page-heading">
      <h1 class="m-page-heading__title">BLOG</h1>
      <p class="m-page-heading__description m-page-heading__description--constrained">
        日々の制作で学んだことと、デザイン、コード、好きなものについてのブログです。
      </p>
    </div>

    <form class="m-blog-search" action="/blog" method="get" role="search">
      <label class="m-blog-search__label" for="blog-search">
        記事を検索
      </label>
      <div class="m-blog-search__field">
        <input
          id="blog-search"
          name="query"
          type="search"
          value={search.query}
          placeholder="記事を検索"
          maxlength={100}
          class="m-blog-search__input"
        />
        <IconButton
          size="sm"
          class="m-blog-search__clear js-blogSearchClear"
          aria-label="検索語をクリア"
        >
          <CloseIcon class="m-blog-search__icon" />
        </IconButton>
      </div>
      <Button type="submit" size="lg">
        検索
      </Button>
    </form>

    {tags.length ? (
      <div class="l-blog-list__tags">
        <span class="l-blog-list__tags-label">タグ</span>
        {tags.map((tag) => (
          <AppLink
            href={blogUrl({
              ...search,
              page: 1,
              tag: search.tag === tag.slug ? "" : tag.slug,
            })}
            variant="surface"
            data-selected={search.tag === tag.slug ? true : undefined}
            class={`l-blog-list__tag ${search.tag === tag.slug ? "l-blog-list__tag--selected" : ""}`}
          >
            #{tag.name}
          </AppLink>
        ))}
      </div>
    ) : null}

    {posts.items.length === 0 ? (
      <div class="m-empty-state">
        <p class="m-empty-state__title">
          {search.query || search.tag
            ? "条件に一致する記事はありません"
            : "まだ記事はありません"}
        </p>
      </div>
    ) : (
      <div class="l-blog-list__cards">
        {posts.items.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}

    {posts.pageCount > 1 ? (
      <nav class="m-pagination" aria-label="ページ送り">
        {posts.page > 1 ? (
          <AppLink
            href={blogUrl({ ...search, page: posts.page - 1 })}
            variant="surface"
            class="m-pagination__link"
          >
            前へ
          </AppLink>
        ) : null}
        <p class="m-pagination__count">
          {posts.page} / {posts.pageCount}
        </p>
        {posts.page < posts.pageCount ? (
          <AppLink
            href={blogUrl({ ...search, page: posts.page + 1 })}
            variant="surface"
            class="m-pagination__link"
          >
            次へ
          </AppLink>
        ) : null}
      </nav>
    ) : null}
  </BlogContainer>
</main>
