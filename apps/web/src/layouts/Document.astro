---
import figtreeCss from "@fontsource-variable/figtree/wght.css?url";
import notoSansJpCss from "@fontsource-variable/noto-sans-jp/wght.css?url";
import { createSeoHead, SITE_TITLE, SITE_DESCRIPTION } from "@/lib/seo";
import PageLoader from "@/features/page-loader/PageLoader.astro";
interface Props {
  css: string;
  title?: string;
  description?: string;
  path?: string;
  siteUrl?: string;
  image?: { url: string; alt: string; width?: number; height?: number };
  type?: "website" | "article";
  noindex?: boolean;
  preview?: boolean;
  structuredData?: string;
  publishedAt?: string | null;
  updatedAt?: string;
}
const {
  css,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  path = Astro.url.pathname,
  siteUrl = Astro.site?.origin ?? Astro.url.origin,
  image,
  type,
  noindex = false,
  preview = false,
  structuredData,
  publishedAt,
  updatedAt,
} = Astro.props;
const seo = createSeoHead({
  siteUrl,
  path,
  title,
  description,
  image,
  type,
  noindex,
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {seo.meta
      .filter(
        (meta) =>
          !("title" in meta) &&
          !(preview && "name" in meta && meta.name === "robots"),
      )
      .map((meta) => (
        <meta {...meta} />
      ))}
    {preview && <meta name="robots" content="noindex,nofollow,noarchive" />}
    {!preview && seo.links.map((link) => <link {...link} />)}
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <link rel="stylesheet" href={figtreeCss} />
    <link rel="stylesheet" href={notoSansJpCss} />
    <link rel="stylesheet" href={css} data-page-stylesheet="active" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="TOMO BLOG"
      href="/feed.xml"
    />
    {structuredData && (
      <script type="application/ld+json" set:html={structuredData} />
    )}
  </head>
  <body>
    <PageLoader />
    <slot />
  </body>
</html>
