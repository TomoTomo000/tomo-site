    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "rolldown": "^1.2.13",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
