{
  "name": "@tomo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "crosspost:preview": "bun --env-file=.dev.vars scripts/crosspost-preview.ts",
    "dev": "astro dev --host 127.0.0.1 --port 4321 --force",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "wrangler preview",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "astro check",
    "crosspost:status": "bun scripts/crosspost-manage.ts status",
    "crosspost:retry": "bun scripts/crosspost-manage.ts retry",
    "crosspost:stop-zenn": "bun scripts/crosspost-manage.ts stop-zenn"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "astro": "^7.3.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "workers-og": "^0.0.27",
    "zod": "^4.5.2"
  },
  "devDependencies": {
