{
  "name": "tomo-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @tomo/web dev",
    "build": "bun run --filter @tomo/web build",
    "preview": "bun run --filter @tomo/web preview",
    "deploy": "bun run --filter @tomo/web deploy",
    "cf-typegen": "bun run --filter @tomo/web cf-typegen",
    "lint": "eslint .",
    "test": "bun run --filter @tomo/web test",
    "typecheck": "bun run --filter @tomo/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.63.1",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.1",
    "source-map-js": "1.2.2"
  }
}
